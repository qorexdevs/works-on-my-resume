---
/**
 * index.astro — the single page of Works on My Resume.
 *
 * Renders the static Astro chrome (header, privacy notice) and mounts the
 * `ResumeStudio` React island, which owns all interactive app state.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AppHeader from '../components/AppHeader.astro';
import PrivacyNotice from '../components/PrivacyNotice.astro';
import ResumeStudio from '../components/ResumeStudio.tsx';
---

<BaseLayout>
  <a class="skip-link" href="#studio">Skip to the resume workbench</a>
  <div class="app-shell">
    {
      /* Each direct child carries a reveal--N modifier that sets the --i
        index driving the staggered page-load reveal in global.css. Done
        via classes, not style="--i: N" — inline style attributes are
        blocked by the CSP (style-src has no 'unsafe-inline'). Collapses
        to the final state instantly under prefers-reduced-motion. */
    }
    <div class="reveal">
      <AppHeader />
    </div>
    <div class="reveal reveal--1">
      <PrivacyNotice />
    </div>
    <main id="studio" class="reveal reveal--2">
      <ResumeStudio client:load />
    </main>
  </div>
</BaseLayout>
